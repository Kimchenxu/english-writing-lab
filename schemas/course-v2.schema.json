{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WriteLab course v2",
  "type": "object",
  "required": [
    "title"
  ],
  "anyOf": [
    {
      "required": [
        "sections"
      ]
    },
    {
      "required": [
        "questions"
      ]
    }
  ],
  "properties": {
    "format": {
      "const": "writelab-course"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "maxLength": 90
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "subject": {
      "type": "string",
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "description": "BCP-47 locale such as es-ES; runtime checks canonical form."
    },
    "program": {
      "type": "string",
      "maxLength": 100
    },
    "level": {
      "type": "string",
      "maxLength": 30
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "unit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "week": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "lessonType": {
      "enum": [
        "learning",
        "review",
        "weekly",
        "unit",
        "final"
      ]
    },
    "examMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "objectives": {
      "$ref": "#/$defs/tags"
    },
    "prerequisites": {
      "$ref": "#/$defs/tags"
    },
    "studyNotes": {
      "$ref": "#/$defs/notes"
    },
    "languageKit": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "section": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "type"
      ],
      "anyOf": [
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "question"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,90}$"
        },
        "type": {
          "enum": [
            "choice",
            "write",
            "fill",
            "conjugation",
            "listening",
            "speaking",
            "flashcard"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "answer": {
          "type": "string",
          "maxLength": 12000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "acceptedAnswers": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "audioText": {
          "type": "string",
          "maxLength": 3000
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "hint": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "minWords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "fill",
                  "conjugation",
                  "flashcard",
                  "listening"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "answer"
                ]
              },
              {
                "required": [
                  "acceptedAnswers"
                ],
                "properties": {
                  "acceptedAnswers": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "listening"
              }
            }
          },
          "then": {
            "required": [
              "audioText"
            ]
          }
        }
      ]
    }
  }
}
